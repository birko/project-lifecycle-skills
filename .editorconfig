# Shared editor style — this repo is markdown + shell/PowerShell.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown uses trailing double-space for hard breaks.
trim_trailing_whitespace = false

[*.{ps1,psm1}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2
